{
  "name": "rpgjs-story-lab",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5197",
    "build": "tsc --noEmit && npm run check:spatial && vite build --mode cloud && node --import tsx scripts/check-original-dist.ts dist && npm run build:worker",
    "preview": "vite preview --host 127.0.0.1 --port 5197",
    "test": "node --import tsx --test _qa/*.test.ts",
    "test:ui": "node --import tsx _qa/scenes-browser.ts",
    "assets": "node --import tsx scripts/assets.ts",
    "export:world": "node --import tsx scripts/export-world.ts",
    "preview:iphone": "CARRIAGE_LAB_DB=.data/iphone-test.sqlite vite preview --host 127.0.0.1 --port 5201 --strictPort",
    "build:pages": "tsc --noEmit && npm run check:spatial && vite build --mode pages --outDir dist-pages && node --import tsx scripts/check-original-dist.ts dist-pages",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1 --port 5202 --strictPort",
    "build:worker": "node scripts/build-worker.mjs",
    "build:cloud": "npm run build",
    "build:preflight": "tsc --noEmit && npm run check:spatial && vite build --mode cloud-preflight --outDir dist-preflight",
    "preview:preflight": "vite preview --mode cloud-preflight --outDir dist-preflight --host 127.0.0.1 --port 5220 --strictPort",
    "build:local": "tsc --noEmit && vite build",
    "check:spatial": "node --import tsx scripts/check-spatial-cartridge.ts",
    "check:spatial-story": "node --import tsx scripts/check-original-branches.ts --spatial"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Carriage 07 \u2014 RPG-JS spatial narrative experiment",
  "devDependencies": {
    "@canvasengine/compiler": "2.2.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "path-browserify": "^1.0.1",
    "playwright": "1.58.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "private": true,
  "dependencies": {
    "@canvasengine/presets": "2.2.0",
    "@rpgjs/client": "5.0.0-beta.34",
    "@rpgjs/common": "5.0.0-beta.31",
    "@rpgjs/server": "5.0.0-beta.34",
    "@rpgjs/tiledmap": "5.0.0-beta.34",
    "@rpgjs/ui-css": "5.0.0-beta.26",
    "@signe/di": "^3.1.1",
    "canvasengine": "2.2.0",
    "pixi.js": "^8.20.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "type": "module"
}
